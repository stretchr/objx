func TestReplace{{.Name}}(t *testing.T) {
	m := objx.Map{"data": []{{.Type}}{ {{.Type}}({{.Example}}), {{.Type}}({{.Example}}), {{.Type}}({{.Example}}), {{.Type}}({{.Example}}), {{.Type}}({{.Example}}), {{.Type}}({{.Example}})}}
